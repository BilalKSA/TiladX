# Production-only. Vite loads this for `vite build`, never for `vite dev`, so
# local development keeps every link same-origin while production builds get
# the tilad.org / app.tilad.org split.
#
# Not secret — these are public URLs, and they must be present wherever the
# production build runs (CI, another machine), so this file IS committed.
VITE_SITE_ORIGIN=https://tilad.org
VITE_APP_ORIGIN=https://app.tilad.org
