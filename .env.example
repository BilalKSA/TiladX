# Split hosting (VITE_SITE_ORIGIN / VITE_APP_ORIGIN) is NOT configured here.
# It lives in `.env.production`, which is committed — Vite loads that file for
# `vite build` only, so production gets the tilad.org / app.tilad.org split
# while `npm run dev` keeps every link on localhost. Do not copy those two
# keys into .env.local: that file is read in dev too, and sign-in links would
# then jump from localhost straight to the live app.

VITE_SUPABASE_URL=https://qmpuczxvgxazjjqazldm.supabase.co
VITE_SUPABASE_ANON_KEY=

# Only used by email.js / workshop-email.js (run standalone via `node --env-file=.env.local <script>`)
RESEND_API_KEY=
